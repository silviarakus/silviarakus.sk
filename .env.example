# Skopíruj tento súbor ako .env a doplň skutočné hodnoty:
#   cp .env.example .env
# Súbor .env je v .gitignore — nikdy sa nekomituje.

# Secret internej Notion integrácie (Notion → Settings → Connections → Develop or manage integrations)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID Notion databázy, do ktorej sa ukladajú výsledky diagnostiky
NOTION_DB_ID=6ddf856752374d7b8f013fff6f00ebef

# Voliteľné: povolený origin pre CORS (default "*")
# ALLOWED_ORIGIN=https://silviarakus.sk

# Voliteľné: port lokálneho servera (default 3000)
# PORT=3000
